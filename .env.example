# ==========================================
# MiniMax 大模型配置 (OpenAI 兼容接口)
# ==========================================
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash
MINIMAX_MAX_TOKENS=2048
MINIMAX_TIMEOUT=30
MINIMAX_TEMPERATURE=0.3

# ==========================================
# 飞书自定义机器人 Webhook 配置
# ==========================================
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_token
# 如开启飞书机器人“签名校验”，请填写对应密钥；未开启可留空
FEISHU_WEBHOOK_SECRET=

# ==========================================
# 量化预警阈值与冷却配置
# ==========================================
# 预警防刷屏冷却时间（分钟），默认 60 分钟
ALERT_COOLDOWN_MINUTES=60
# 放量判定：累计量能同比昨日同时刻阈值（默认 1.20 即放量 20%）
ALERT_VOLUME_RATIO_THRESHOLD=1.20
# 边际放量判定：近30分钟量能相对前序均值倍数阈值（默认 1.35）
ALERT_MARGINAL_RATIO_THRESHOLD=1.35
# 放量上涨：主要指数平均涨跌幅阈值（%，默认 0.60%）
ALERT_SURGE_CHANGE_PCT=0.60
# 放量下跌：主要指数平均涨跌幅阈值（%，默认 -0.60%）
ALERT_PLUNGE_CHANGE_PCT=-0.60
# 放量上涨：全市场上涨家数占比阈值（默认 0.60 即 60%）
ALERT_SURGE_ADVANCE_RATIO=0.60
# 放量下跌：全市场上涨家数占比阈值（默认 0.40 即 40%）
ALERT_PLUNGE_ADVANCE_RATIO=0.40

# ==========================================
# 运行与调度配置
# ==========================================
TIMEZONE=Asia/Shanghai
STATE_DIR=./data
LOG_LEVEL=INFO
SECTOR_TOP_N=5
